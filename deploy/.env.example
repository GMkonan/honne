# Keep backend and frontend on the same immutable release tag.
HONNE_VERSION=v0.1.0

# Stable volume name. Change this only when intentionally selecting another
# installation's data volume.
HONNE_DATA_VOLUME=honne-data

# Local-only access by default. Use 7417 instead to listen on the local network.
HONNE_PORT=127.0.0.1:7417
APP_ORIGIN=http://localhost:7417

PROFILE_NAME=My Library
PROFILE_AVATAR_URL=

# Optional HTTP Basic authentication. Always use HTTPS outside a trusted network.
APP_USERNAME=
APP_PASSWORD=

# Required only for movie and series discovery.
TMDB_API_TOKEN=
# Required only for game discovery. Create a personal key at https://rawg.io/apidocs.
RAWG_API_KEY=
# Recommended by Open Library for identified requests.
APP_CONTACT_EMAIL=

# Optional AniList OAuth integration. Configure all three values or none.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URL=
ANILIST_DELETE_ON_LOCAL_DELETE=true

# Provider endpoint overrides, mainly for troubleshooting.
ANILIST_API_URL=https://graphql.anilist.co
KITSU_API_URL=https://kitsu.io/api/edge
OPEN_LIBRARY_API_URL=https://openlibrary.org
TMDB_API_URL=https://api.themoviedb.org/3
RAWG_API_URL=https://api.rawg.io/api
