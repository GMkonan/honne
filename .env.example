# Port exposed by Docker Compose. You can also bind only to localhost, for
# example: HONNE_PORT=127.0.0.1:8080
HONNE_PORT=8080

# Exact public base URL of this installation, without a trailing slash.
APP_ORIGIN=http://localhost:8080

# Optional HTTP Basic authentication. Set both values or leave both empty.
# Always use HTTPS when credentials cross an untrusted network.
APP_USERNAME=
APP_PASSWORD=

# Required only for movie and series discovery.
TMDB_API_TOKEN=
# Recommended by Open Library for identified requests.
APP_CONTACT_EMAIL=

# AniList OAuth. Register a client whose redirect URL exactly matches this value.
# For the default local deployment, use:
# http://localhost:8080/api/integrations/anilist/callback
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URL=

# If true, deleting a synchronized title locally also removes its AniList entry.
# The remote deletion remains safely queued if AniList is temporarily unavailable.
ANILIST_DELETE_ON_LOCAL_DELETE=true

# Optional provider endpoint overrides, mainly for development/testing.
ANILIST_API_URL=https://graphql.anilist.co
OPEN_LIBRARY_API_URL=https://openlibrary.org
TMDB_API_URL=https://api.themoviedb.org/3
