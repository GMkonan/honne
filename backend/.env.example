# Local development configuration. Docker Compose uses ../.env instead.
PORT=8080
DATA_PATH=data/media.json
APP_ORIGIN=http://localhost:5173

# Personal profile shown in the Library hero.
PROFILE_NAME=My Library
PROFILE_AVATAR_URL=

# Optional HTTP Basic authentication. Set both or neither.
APP_USERNAME=
APP_PASSWORD=

# Required only for movie and series discovery.
TMDB_API_TOKEN=
# Recommended by Open Library for identified requests.
APP_CONTACT_EMAIL=

# AniList outbound synchronization. Register the exact callback URL in AniList.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# Use http://localhost:8080/api/integrations/anilist/callback when enabling OAuth.
ANILIST_REDIRECT_URL=
ANILIST_DELETE_ON_LOCAL_DELETE=true

# Optional provider endpoint overrides, primarily for development/testing.
ANILIST_API_URL=https://graphql.anilist.co
OPEN_LIBRARY_API_URL=https://openlibrary.org
TMDB_API_URL=https://api.themoviedb.org/3

# Optional file overrides.
# ANILIST_AUTH_PATH=data/anilist-auth.json
# ENV_FILE=.env
